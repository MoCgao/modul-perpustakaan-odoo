<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_data_member_list" model="ir.ui.view">
        <field name="name">data.member.list</field>
        <field name="model">data.member</field>
        <field name="arch" type="xml">
            <list string="Data Member">
                <field name="member_id"/>
                <field name="name"/>
                <field name="siswa_id"/>
                <field name="tanggal_daftar"/>
                <field name="status"/>
                <field name="batas_pinjam"/>
            </list>
        </field>
    </record>

    <record id="view_data_member_form" model="ir.ui.view">
        <field name="name">data.member.form</field>
        <field name="model">data.member</field>
        <field name="arch" type="xml">
            <form string="Data Member">
                <sheet>
                    <group>
                        <group>
                            <field name="member_id"/>
                            <field name="name"/>
                            <field name="siswa_id"/>
                        </group>
                        <group>
                            <field name="tanggal_daftar"/>
                            <field name="status"/>
                            <field name="batas_pinjam"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_data_member" model="ir.actions.act_window">
        <field name="name">Member</field>
        <field name="res_model">data.member</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>