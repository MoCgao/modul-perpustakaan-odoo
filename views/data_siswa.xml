<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_data_siswa_list" model="ir.ui.view">
        <field name="name">data.siswa.list</field>
        <field name="model">data.siswa</field>
        <field name="arch" type="xml">
            <list string="Data Siswa">
                <field name="nis"/>
                <field name="nama_siswa"/>
                <field name="kelas"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_data_siswa_form" model="ir.ui.view">
        <field name="name">data.siswa.form</field>
        <field name="model">data.siswa</field>
        <field name="arch" type="xml">
            <form string="Data Siswa">
                <sheet>
                    <group>
                        <group>
                            <field name="nis"/>
                            <field name="nama_siswa"/>
                        </group>
                        <group>
                            <field name="kelas"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_data_siswa" model="ir.actions.act_window">
        <field name="name">Siswa</field>
        <field name="res_model">data.siswa</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>