<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_data_buku_list" model="ir.ui.view">
        <field name="name">data.buku.list</field>
        <field name="model">data.buku</field>
        <field name="arch" type="xml">
            <list string="Data Buku">
                <field name="judul_buku"/>
                <field name="penulis"/>
                <field name="penerbit"/>
                <field name="kategori"/>
            </list>
        </field>
    </record>


    <record id="view_data_buku_form" model="ir.ui.view">
        <field name="name">data.buku.form</field>
        <field name="model">data.buku</field>
        <field name="arch" type="xml">
            <form string="Data Buku">
                <sheet>
                    <group>
                        <group>
                            <field name="judul_buku"/>
                            <field name="penulis"/>
                            <field name="penerbit"/>
                        </group>
                        <group>
                            <field name="tahun_terbit"/>
                            <field name="jumlah_halaman"/>
                            <field name="kategori"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_data_buku" model="ir.actions.act_window">
        <field name="name">Buku</field>
        <field name="res_model">data.buku</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>