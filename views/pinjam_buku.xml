<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pinjam_buku_list" model="ir.ui.view">
        <field name="name">pinjam.buku.list</field>
        <field name="model">pinjam.buku</field>
        <field name="arch" type="xml">
            <list string="Peminjaman Buku">
                <field name="nomor_pinjam"/>
                <field name="member_id"/>
                <field name="buku_id"/>
                <field name="tanggal_pinjam"/>
                <field name="tanggal_pengembalian"/>
            </list>
        </field>
    </record>


    <record id="view_pinjam_buku_form" model="ir.ui.view">
        <field name="name">pinjam.buku.form</field>
        <field name="model">pinjam.buku</field>
        <field name="arch" type="xml">
            <form string="Peminjaman Buku">
                <sheet>
                    <group>
                        <group>
                            <field name="nomor_pinjam"/>
                            <field name="member_id"/>
                            <field name="buku_id"/>
                        </group>
                        <group>
                            <field name="tanggal_pinjam"/>
                            <field name="tanggal_pengembalian"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_pinjam_buku" model="ir.actions.act_window">
        <field name="name">Peminjaman Buku</field>
        <field name="res_model">pinjam.buku</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>